{
  "name": "patchplan",
  "private": true,
  "version": "1.0.0",
  "description": "Patch Plan Editor - stage cable / patch plan editor (single HTML file)",
  "scripts": {
    "build": "node -e \"require('fs').copyFileSync('patchplan.html','public/index.html')\"",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true
  }
}
